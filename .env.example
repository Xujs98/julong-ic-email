# 默认只允许宿主机反向代理访问；直接开放服务器端口时填写 0.0.0.0。
JULONG_IMAGE=docker.io/qq1371446705/julong-ic-email:latest
JULONG_BIND_IP=127.0.0.1
JULONG_PORT=8787
TZ=Asia/Shanghai

# 留空时根据浏览器请求的域名生成 API 和 HTML 地址。
IPM_PUBLIC_BASE_URL=

# 可选配置，请勿提交填写后的 .env 文件。
IPM_API_KEY=
IPM_APPLE_ACCOUNT_API_KEY=

# 域名邮箱 SMTP 的启停、监听地址、容器端口和邮件大小在后台“系统设置”配置。
# Docker 默认将宿主机 TCP 25 映射到容器 2525，无需在 .env 中填写 SMTP 参数。
